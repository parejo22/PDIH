%!PS-Adobe-3.0
<< /PageSize [842 595] >> setpagedevice


newpath
1 0 0 setrgbcolor
300 300 200 0 360 arc
fill

newpath
0 1 0 setrgbcolor
300 300 150 0 360 arc
fill

newpath
